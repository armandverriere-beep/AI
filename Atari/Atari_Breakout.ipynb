    "N_TRIALS = 1000        \n",
    "GAMES_PER_TRIAL = 10   \n",
    "THRESHOLD = 2.0        \n",
    "SEED = 42              \n",
    "CACHE_FILE = 'breakout_session_means.npy'   "
   ]
  },
